module(lireSub;path ;infoLigneSet)
---*
fp = open(path, 'r')
if (fp == NULL)
sortir "Erreur dans l'ouverture du fichier" + path

else
row = 0
while ( le fichier a au moins encore une ligne à lire && row < 601)
row ++
column = 0
if (row == 1)
continue

else
value = séparation des valeurs de la ligne en colonnes délimitées par ","
while(value)
// on ne détaille que les colones qui nous intéressent dans le cadre de la phase 1
if (column == 0)
infosLigneSub.numLigne = value

else if (column == 10)
infosLigneSub.userAccelerationX = value

else if (column == 11)
infosLigneSub.userAccelerationY = value

else if (column == 12)
infosLigneSub.userAccelerationZ = value
----
value = valeur suivante dans la ligne
column++
----
infosLigneSet.tabVAcc[row-2] = racine(infosLigneSub.userAccelerationX**2 + infosLigneSub.userAccelerationY**2 + infosLigneSub.userAccelerationY**2);
----
// sécurité si fichier compte moins de 600 lignes
while(row < 601)
infosLigneSet.tabVAcc[row-1] = 0; 
row++;
----
----
----
close(fp)
----

module(initialisationSet;path;)
---*
fp = open(path, "w")

écrire dans le fichier : "Mouvement,Genre,Index"
i = 0
while (i < 600)
écrire dans le fichier : ",Vacc"
i++
----
écrire dans le fichier : "\n"
close(fp)
----

module(ecrireSet;path, infosLigneSet;)
----*
fp = open(path, 'a')
if (fp == NULL)
sortir "Erreur dans l'ouverture du fichier" + path

else
ecrire dans le fichier : infosLigneSet.mouvement + "," infosLigneSet.genre + "," infosLigneSet.index

i = 0
while (i < 600)
if (infosLigneSet.tabVacc[i] == 0)
break;
else
écrire dans le fichier : "," + infosLigneSet.tabVAcc[i]
----
i++
----
écrire dans le fichier : "\n"
----
close(fp)
----

